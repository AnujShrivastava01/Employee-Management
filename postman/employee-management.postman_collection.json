                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "sortBy",
                  "value": "fullName"
                }
              ]
            },
            "description": "Exports every row matching the filters (not just one page). Use Send and Download in Postman to save the file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"CSV content type and attachment\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\"); pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\"); });",
                  "pm.test(\"Header row present\", function () { pm.expect(pm.response.text()).to.include(\"Employee ID,Full Name,Email,Phone,Department,Designation,Date of Joining,Salary (INR),Status\"); });"
                ]
              }
            }
          ]
        },
        {
