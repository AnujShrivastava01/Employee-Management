                  "pm.test(\"Field errors are listed\", function () { pm.expect(pm.response.json().fieldErrors.length).to.be.above(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create employee - duplicate (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "Run after 'Update employee', whose employee ID (PM-UPDATED) is now taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"PM-UPDATED\",\n  \"fullName\": \"Ananya Iyer\",\n  \"email\": \"someone.else@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"departmentId\": {{departmentId}},\n  \"designation\": \"Senior Software Engineer\",\n  \"dateOfJoining\": \"2023-06-12\",\n  \"salary\": 1850000.5,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Duplicate employee ID\", function () { pm.expect(pm.response.json().code).to.eql(\"DUPLICATE_EMPLOYEE_ID\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const s = pm.response.json();",
                  "pm.test(\"Totals add up\", function () { pm.expect(s.activeEmployees + s.inactiveEmployees).to.eql(s.totalEmployees); });",
                  "pm.test(\"Has distribution and recent joiners\", function () { pm.expect(s.departmentDistribution).to.be.an(\"array\"); pm.expect(s.recentlyJoined).to.be.an(\"array\"); });",
                  "pm.test(\"Hiring trend covers 12 months\", function () { pm.expect(s.hiringTrend).to.have.length(12); pm.expect(s.hiringTrend[11]).to.have.property(\"month\"); });"
                ]
