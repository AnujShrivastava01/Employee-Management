# Copy to `.env` and adjust. These are LOCAL-DEVELOPMENT defaults only —
# change every secret before deploying anywhere shared.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=ems
POSTGRES_USER=ems
POSTGRES_PASSWORD=ems_password
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8080
# Used by the backend when run outside Docker (docker-compose overrides the host with `db`).
DB_URL=jdbc:postgresql://localhost:5432/ems
DB_USERNAME=ems
DB_PASSWORD=ems_password
# Comma separated list of browser origins allowed to call the API directly (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Initial administrator, created on first start when no user exists.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed in the backend log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
# Load realistic demo departments/employees when the database is empty (dev/demo only).
SEED_DEMO_DATA=true
# Set to true when serving over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
# Where the Next.js server proxies /api/* to. Local dev: http://localhost:8080.
# Inside docker-compose this is baked at build time to http://backend:8080.
BACKEND_INTERNAL_URL=http://localhost:8080
